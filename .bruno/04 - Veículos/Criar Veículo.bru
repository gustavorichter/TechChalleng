meta {
  name: Criar Veículo
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/veiculos
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "cliente_id": "{{clienteId}}",
    "placa": "ABC1D23",
    "marca": "Volkswagen",
    "modelo": "Gol",
    "ano": 2022
  }
}

script:post-response {
  if (res.status === 201 && res.body.id) {
    bru.setEnvVar("veiculoId", res.body.id);
  }
}
