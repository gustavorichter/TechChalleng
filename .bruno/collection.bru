meta {
  name: Oficina Mecânica API
}

auth {
  mode: none
}

vars:pre-request {
  baseUrl: http://localhost:8080
}

docs {
  Collection Bruno para o Sistema Integrado de Atendimento e Execução de Serviços.
  Execute "Login" primeiro para popular o token. As rotas de criação salvam IDs automaticamente nas variáveis de ambiente.
}
