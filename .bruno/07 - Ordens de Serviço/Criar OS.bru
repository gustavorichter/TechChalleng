meta {
  name: Criar OS
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/ordens-servico
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "cliente_id": "{{clienteId}}",
    "veiculo_id": "{{veiculoId}}",
    "observacoes": "Barulho no motor ao acelerar"
  }
}

script:post-response {
  if (res.status === 201 && res.body.id) {
    bru.setEnvVar("osId", res.body.id);
  }
}
