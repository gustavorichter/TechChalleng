meta {
  name: Avançar Status OS
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/v1/ordens-servico/{{osId}}/avancar
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

docs {
  Avança um passo, exceto quando a OS está em "Aguardando aprovação".
  Nesse status a API responde 400 e exige POST /ordens-servico/{{osId}}/orcamento.
  Depois da aprovação, este avanço vai para "Finalizada", baixa o estoque
  e oculta a OS da listagem.
}
