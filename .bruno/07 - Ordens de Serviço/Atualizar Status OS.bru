meta {
  name: Atualizar Status OS
  type: http
  seq: 6
}

put {
  url: {{baseUrl}}/api/v1/ordens-servico/{{osId}}/status
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "status": "Em diagnóstico"
  }
}

docs {
  Este exemplo faz só a primeira transição: Recebida → Em diagnóstico.
  Em seguida use "Enviar para Aprovação". A saída de "Aguardando aprovação"
  não passa por este endpoint: aprove ou recuse em "Decidir Orçamento".
}
