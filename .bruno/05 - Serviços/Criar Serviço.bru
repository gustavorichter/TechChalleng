meta {
  name: Criar Serviço
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/servicos
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "nome": "Troca de óleo",
    "descricao": "Troca completa com filtro",
    "valor_mao_obra": "150.00"
  }
}

script:post-response {
  if (res.status === 201 && res.body.id) {
    bru.setEnvVar("servicoId", res.body.id);
  }
}
