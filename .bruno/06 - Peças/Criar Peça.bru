meta {
  name: Criar Peça
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/pecas
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "nome": "Filtro de óleo",
    "codigo": "FLT001",
    "valor_unitario": "45.00",
    "quantidade_estoque": 20
  }
}

script:post-response {
  if (res.status === 201 && res.body.id) {
    bru.setEnvVar("pecaId", res.body.id);
  }
}
