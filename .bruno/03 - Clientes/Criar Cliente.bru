meta {
  name: Criar Cliente
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/clientes
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "nome": "João Silva",
    "cpf": "529.982.247-25",
    "email": "joao@email.com",
    "telefone": "11999999999"
  }
}

script:post-response {
  if (res.status === 201 && res.body.id) {
    bru.setEnvVar("clienteId", res.body.id);
  }
}
